---
source: lexion_lang/tests/x86_smoke.rs
expression: "compile_x86(\"backend/x86_nested_function_value.lex\")"
---
.intel_syntax noprefix
.text
.global apply
apply:
# fn apply(callback: fn(i32) -> i32, value: i32) -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 16
  mov QWORD PTR [rbp-8], rdi
  mov DWORD PTR [rbp-16], esi
#     return callback(value);
  mov r11, QWORD PTR [rbp-8]
  mov eax, DWORD PTR [rbp-16]
  push rax
  pop rdi
  call r11
  add rsp, 16
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  pop rbp
  ret
.global add_one
add_one:
  push rbp
  mov rbp, rsp
#     fn add_one(value: i32) -> i32 {
#         return value + 1;
  mov eax, edi
  add eax, 1
  pop rbp
  ret
#     return apply(add_one, 4);
  mov eax, 4
  push rax
  lea rax, [add_one]
  push rax
  pop rdi
  pop rsi
  call apply
  pop rbp
  ret
