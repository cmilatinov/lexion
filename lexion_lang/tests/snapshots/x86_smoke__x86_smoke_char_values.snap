.intel_syntax noprefix
.text
.global pass
pass:
# fn pass(value: char) -> char {
  push rbp
  mov rbp, rsp
#     let local: char = value;
  mov eax, edi
#     return local;
  pop rbp
  ret
.global select
select:
# fn select(first: char, second: char, choose_first: bool) -> char {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     let selected: char = if choose_first { first } else { second };
  cmp edx, 0
  je $celse_1
$cthen_1:
  mov eax, edi
  mov DWORD PTR [rbp-8], eax
  jmp $cend_1
$celse_1:
  mov eax, esi
  mov DWORD PTR [rbp-8], eax
$cend_1:
  mov eax, DWORD PTR [rbp-8]
#     return selected;
  add rsp, 16
  pop rbp
  ret
.global same
same:
# fn same(left: char, right: char) -> bool {
  push rbp
  mov rbp, rsp
#     return left == right;
  mov eax, edi
  cmp eax, esi
  sete al
  movzx eax, al
  pop rbp
  ret
.global main
main:
# fn main(value: char, fallback: char) -> char {
  push rbp
  mov rbp, rsp
  sub rsp, 16
  mov DWORD PTR [rbp-8], esi
#     let selected: char = select(value, fallback, true);
  mov eax, 1
  push rax
  mov eax, DWORD PTR [rbp-8]
  push rax
  mov eax, edi
  push rax
  pop rdi
  pop rsi
  pop rdx
  call select
  mov DWORD PTR [rbp-16], eax
#     let matched: bool = same(selected, fallback);
  mov eax, DWORD PTR [rbp-8]
  push rax
  mov eax, DWORD PTR [rbp-16]
  push rax
  pop rdi
  pop rsi
  call same
  mov edi, eax
#     let final: char = if matched { fallback } else { selected };
  cmp edi, 0
  je $celse_2
$cthen_2:
  mov eax, DWORD PTR [rbp-8]
  jmp $cend_2
$celse_2:
  mov eax, DWORD PTR [rbp-16]
$cend_2:
  mov edi, eax
#     return pass(final);
  mov eax, edi
  push rax
  pop rdi
  call pass
  add rsp, 16
  pop rbp
  ret
