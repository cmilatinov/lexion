.global select
select:
# fn select(first: char, second: char, choose_first: bool) -> char {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     let selected: char = if choose_first { first } else { second };
  cmp edx, 0
  je $celse_1
$cthen_1:
  mov eax, edi
  mov DWORD PTR [rbp-4], eax
  jmp $cend_1
$celse_1:
  mov eax, esi
  mov DWORD PTR [rbp-4], eax
$cend_1:
  mov eax, DWORD PTR [rbp-4]
#     return selected;
  add rsp, 16
  pop rbp
  ret
.global main
main:
# fn main(value: char, fallback: char) -> char {
  push rbp
  mov rbp, rsp
#     let selected: char = select(value, fallback, true);
  mov eax, 1
  push rax
  mov eax, esi
  push rax
  mov eax, edi
  push rax
  pop rdi
  pop rsi
  pop rdx
  call select
  mov edi, eax
#     return pass(selected);
  mov eax, edi
  push rax
  pop rdi
  call pass
  pop rbp
  ret
