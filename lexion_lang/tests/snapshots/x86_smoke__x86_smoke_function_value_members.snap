.intel_syntax noprefix
.text
.global add_one
add_one:
# fn add_one(value: i32) -> i32 {
  push rbp
  mov rbp, rsp
#     return value + 1;
  mov eax, edi
  add eax, 1
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  push rbx
  sub rsp, 16
#     let holder = Holder { callback: add_one };
  lea rax, [add_one]
  mov QWORD PTR [rbp-16], rax
  mov eax, DWORD PTR [rbp-16]
  mov DWORD PTR [rbp-24], eax
  mov eax, DWORD PTR [rbp-16+4]
  mov DWORD PTR [rbp-24+4], eax
#     holder.callback = add_one;
  lea rax, [add_one]
  mov QWORD PTR [rbp-24], rax
#     return holder.callback(4);
  mov rbx, QWORD PTR [rbp-24]
  mov r11, rbx
  mov eax, 4
  push rax
  pop rdi
  sub rsp, 8
  call r11
  add rsp, 8
  add rsp, 16
  pop rbx
  pop rbp
  ret
