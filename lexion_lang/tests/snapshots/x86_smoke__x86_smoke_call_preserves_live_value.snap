.intel_syntax noprefix
.text
.global add_one
add_one:
# fn add_one(value: i32) -> i32 {
  push rbp
  mov rbp, rsp
#     return value + 1;
  mov eax, edi
  add eax, 1
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     let value = 4;
  mov eax, 4
  mov DWORD PTR [rbp-8], eax
#     let next = add_one(value);
  mov eax, DWORD PTR [rbp-8]
  push rax
  pop rdi
  call add_one
  mov edi, eax
#     return next + value;
  mov eax, edi
  add eax, DWORD PTR [rbp-8]
  add rsp, 16
  pop rbp
  ret
