.intel_syntax noprefix
.text
.global add_one
add_one:
# fn add_one(value: i32) -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     return value + 1;
  add eax, 1
  mov DWORD PTR [rbp-8], eax
  mov eax, DWORD PTR [rbp-8]
  add rsp, 16
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     let callback = add_one;
  lea rax, [add_one]
#     return callback(4);
  push rax
  xchg QWORD PTR [rsp], rax
  mov eax, 4
  push rax
  pop rdi
  sub rsp, 8
  call QWORD PTR [rsp+8]
  add rsp, 8
  add rsp, 8
  mov DWORD PTR [rbp-8], eax
  mov eax, DWORD PTR [rbp-8]
  add rsp, 16
  pop rbp
  ret
