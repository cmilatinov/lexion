  mov eax, DWORD PTR [rbp-36+16]
  mov DWORD PTR [rbp-68+16], eax
#     return value.first + value.second + value.third + value.fourth + value.fifth;
  mov eax, DWORD PTR [rbp-68]
  mov esi, DWORD PTR [rbp-64]
  mov edx, eax
