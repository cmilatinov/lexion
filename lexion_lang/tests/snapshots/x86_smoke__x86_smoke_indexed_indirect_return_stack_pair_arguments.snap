.global pack
pack:
# fn pack(a: i32, b: i32, c: i32, d: i32, e: i32, tail: i32, triple: Triple) -> Large {
  push rbp
  mov rbp, rsp
  sub rsp, 48
  mov QWORD PTR [rbp-48], rdi
  mov edi, DWORD PTR [rbp+16]
  mov eax, DWORD PTR [rbp+24]
  mov DWORD PTR [rbp-40], eax
  mov eax, DWORD PTR [rbp+24+4]
  mov DWORD PTR [rbp-40+4], eax
  mov eax, DWORD PTR [rbp+24+8]
  mov DWORD PTR [rbp-40+8], eax
#         first: a + tail,
  mov r10d, esi
  add r10d, edi
  mov DWORD PTR [rbp-28], r10d
#         second: b + triple.first,
  mov edi, DWORD PTR [rbp-40]
  mov esi, edx
  add esi, edi
  mov DWORD PTR [rbp-24], esi
#         third: c + triple.second,
  mov edi, DWORD PTR [rbp-36]
  mov esi, ecx
  add esi, edi
  mov DWORD PTR [rbp-20], esi
#         fourth: d + triple.third,
  mov edi, DWORD PTR [rbp-32]
  mov esi, r8d
  add esi, edi
  mov DWORD PTR [rbp-16], esi
#         fifth: e
  mov DWORD PTR [rbp-12], r9d
#     return Large {
#         first: a + tail,
#         second: b + triple.first,
#         third: c + triple.second,
#         fourth: d + triple.third,
#         fifth: e
#     };
  mov rax, QWORD PTR [rbp-48]
  mov ecx, DWORD PTR [rbp-28]
  mov DWORD PTR [rax+0], ecx
  mov ecx, DWORD PTR [rbp-28+4]
  mov DWORD PTR [rax+4], ecx
  mov ecx, DWORD PTR [rbp-28+8]
  mov DWORD PTR [rax+8], ecx
  mov ecx, DWORD PTR [rbp-28+12]
  mov DWORD PTR [rax+12], ecx
  mov ecx, DWORD PTR [rbp-28+16]
  mov DWORD PTR [rax+16], ecx
  mov rax, QWORD PTR [rbp-48]
  add rsp, 48
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 80
#     let value = pack(1, 2, 3, 4, 5, 6, Triple { first: 7, second: 8, third: 9 });
  mov eax, 7
  mov DWORD PTR [rbp-48], eax
  mov eax, 8
  mov DWORD PTR [rbp-44], eax
  mov eax, 9
  mov DWORD PTR [rbp-40], eax
