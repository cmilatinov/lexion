.intel_syntax noprefix
.text
.global combine
combine:
# fn combine(a: i32, b: i32, c: i32) -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     let first = a + b;
  mov eax, edi
  add eax, esi
  mov DWORD PTR [rbp-4], eax
  mov eax, DWORD PTR [rbp-4]
#     return first + c;
  mov eax, DWORD PTR [rbp-4]
  add eax, edx
  add rsp, 16
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
#     return combine(2, 3, 4);
  mov eax, 4
  push rax
  mov eax, 3
  push rax
  mov eax, 2
  push rax
  pop rdi
  pop rsi
  pop rdx
  call combine
  pop rbp
  ret
