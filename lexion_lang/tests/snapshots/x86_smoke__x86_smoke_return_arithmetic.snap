main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 16
#     let value = 1 + 2 * 3;
  mov eax, 2
  imul eax, 3
  mov edi, 1
  add edi, eax
  mov eax, edi
  mov DWORD PTR [rbp-8], eax
#     return value - 4;
