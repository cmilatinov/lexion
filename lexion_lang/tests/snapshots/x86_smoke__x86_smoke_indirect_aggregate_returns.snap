.global make_large
make_large:
# fn make_large(base: i32, extra: i32) -> Large {
  push rbp
  mov rbp, rsp
  sub rsp, 32
  mov QWORD PTR [rbp-28], rdi
#         first: base,
  mov DWORD PTR [rbp-20], esi
#         second: base + 1,
  mov edi, esi
  add edi, 1
  mov DWORD PTR [rbp-16], edi
#         third: base + 2,
  mov edi, esi
  add edi, 2
  mov DWORD PTR [rbp-12], edi
#         fourth: base + 3,
  mov edi, esi
  add edi, 3
  mov DWORD PTR [rbp-8], edi
#         fifth: extra
  mov DWORD PTR [rbp-4], edx
#     return Large {
#         first: base,
#         second: base + 1,
#         third: base + 2,
#         fourth: base + 3,
#         fifth: extra
#     };
  mov rax, QWORD PTR [rbp-28]
  mov ecx, DWORD PTR [rbp-20]
  mov DWORD PTR [rax+0], ecx
  mov ecx, DWORD PTR [rbp-20+4]
  mov DWORD PTR [rax+4], ecx
  mov ecx, DWORD PTR [rbp-20+8]
  mov DWORD PTR [rax+8], ecx
  mov ecx, DWORD PTR [rbp-20+12]
  mov DWORD PTR [rax+12], ecx
  mov ecx, DWORD PTR [rbp-20+16]
  mov DWORD PTR [rax+16], ecx
  mov rax, QWORD PTR [rbp-28]
  add rsp, 32
  pop rbp
  ret
.global make_tuple
make_tuple:
# fn make_tuple(base: i32, extra: i32) -> (i32, i32, i32, i32, i32) {
  push rbp
  mov rbp, rsp
  sub rsp, 32
  mov QWORD PTR [rbp-28], rdi
#     return (base, base + 1, base + 2, base + 3, extra);
  mov DWORD PTR [rbp-20], esi
  mov edi, esi
  add edi, 1
  mov DWORD PTR [rbp-16], edi
  mov edi, esi
  add edi, 2
  mov DWORD PTR [rbp-12], edi
  mov edi, esi
  add edi, 3
  mov DWORD PTR [rbp-8], edi
  mov DWORD PTR [rbp-4], edx
  mov rax, QWORD PTR [rbp-28]
  mov ecx, DWORD PTR [rbp-20]
  mov DWORD PTR [rax+0], ecx
  mov ecx, DWORD PTR [rbp-20+4]
  mov DWORD PTR [rax+4], ecx
  mov ecx, DWORD PTR [rbp-20+8]
  mov DWORD PTR [rax+8], ecx
  mov ecx, DWORD PTR [rbp-20+12]
  mov DWORD PTR [rax+12], ecx
  mov ecx, DWORD PTR [rbp-20+16]
  mov DWORD PTR [rax+16], ecx
  mov rax, QWORD PTR [rbp-28]
  add rsp, 32
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  push rbx
  sub rsp, 96
#     let large = make_large(10, 20);
