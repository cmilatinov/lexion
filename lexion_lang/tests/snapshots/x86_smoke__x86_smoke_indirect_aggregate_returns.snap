  mov DWORD PTR [rbp-96+8], eax
  mov eax, DWORD PTR [rbp-56+12]
  mov DWORD PTR [rbp-96+12], eax
  mov eax, DWORD PTR [rbp-56+16]
  mov DWORD PTR [rbp-96+16], eax
#     return large.first + large.fifth + tuple.0 + tuple.4;
