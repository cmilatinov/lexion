# fn make_large() -> Large {
  push rbp
  mov rbp, rsp
  sub rsp, 32
  mov QWORD PTR [rbp-28], rdi
#         first: 1,
  mov eax, 1
  mov DWORD PTR [rbp-20], eax
#         second: 2,
