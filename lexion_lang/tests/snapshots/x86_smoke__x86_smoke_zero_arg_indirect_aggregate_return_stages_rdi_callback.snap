  mov DWORD PTR [rbp-4], eax
#     return Large {
#         first: 1,
#         second: 2,
#         third: 3,
#         fourth: 4,
#         fifth: 5
#     };
  mov rax, QWORD PTR [rbp-28]
  mov ecx, DWORD PTR [rbp-20]
  mov DWORD PTR [rax+0], ecx
  mov ecx, DWORD PTR [rbp-20+4]
  mov DWORD PTR [rax+4], ecx
  mov ecx, DWORD PTR [rbp-20+8]
  mov DWORD PTR [rax+8], ecx
  mov ecx, DWORD PTR [rbp-20+12]
  mov DWORD PTR [rax+12], ecx
  mov ecx, DWORD PTR [rbp-20+16]
  mov DWORD PTR [rax+16], ecx
  mov rax, QWORD PTR [rbp-28]
  add rsp, 32
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
  push rbp
  mov rbp, rsp
  sub rsp, 64
#     let callback = make_large;
