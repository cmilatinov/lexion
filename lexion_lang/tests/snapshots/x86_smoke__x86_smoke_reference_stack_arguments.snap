.global select_last
select_last:
# fn select_last(
  push rbp
  mov rbp, rsp
  sub rsp, 16
  mov rax, QWORD PTR [rbp+16]
  mov QWORD PTR [rbp-8], rax
#     return g;
  mov rax, QWORD PTR [rbp-8]
  add rsp, 16
  pop rbp
  ret
.global main
main:
# fn main() -> i32 {
