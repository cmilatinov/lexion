  mov DWORD PTR [rbp-40+4], eax
  add rsp, 8
  push rsi
  mov eax, DWORD PTR [rsp]
  mov DWORD PTR [rbp-40+8], eax
  add rsp, 8
#     return (value.0 + 1, value.1 + 2, value.2 + 3);
  mov eax, DWORD PTR [rbp-40]
  mov edi, eax
  add edi, 1
  mov DWORD PTR [rbp-28], edi
  mov eax, DWORD PTR [rbp-36]
  mov edi, eax
  add edi, 2
  mov DWORD PTR [rbp-24], edi
  mov eax, DWORD PTR [rbp-32]
  mov edi, eax
  add edi, 3
  mov DWORD PTR [rbp-20], edi
  sub rsp, 8
  mov QWORD PTR [rsp], 0
  mov eax, DWORD PTR [rbp-28]
  mov DWORD PTR [rsp], eax
  mov eax, DWORD PTR [rbp-28+4]
  mov DWORD PTR [rsp+4], eax
  mov rax, QWORD PTR [rsp]
  add rsp, 8
  sub rsp, 8
  mov QWORD PTR [rsp], 0
  mov eax, DWORD PTR [rbp-28+8]
  mov DWORD PTR [rsp], eax
  mov rdx, QWORD PTR [rsp]
  add rsp, 8
  add rsp, 48
  pop rbp
  ret
