.global shift_quad
shift_quad:
# fn shift_quad(value: Quad) -> Quad {
  push rbp
  mov rbp, rsp
  sub rsp, 48
  push rdi
  mov eax, DWORD PTR [rsp]
  mov DWORD PTR [rbp-48], eax
  mov eax, DWORD PTR [rsp+4]
  mov DWORD PTR [rbp-48+4], eax
  add rsp, 8
  push rsi
  mov eax, DWORD PTR [rsp]
  mov DWORD PTR [rbp-48+8], eax
  mov eax, DWORD PTR [rsp+4]
  mov DWORD PTR [rbp-48+8+4], eax
  add rsp, 8
#         first: value.first + 1,
  mov eax, DWORD PTR [rbp-48]
  mov edi, eax
  add edi, 1
  mov DWORD PTR [rbp-32], edi
#         second: value.second + 2,
  mov eax, DWORD PTR [rbp-44]
  mov edi, eax
  add edi, 2
  mov DWORD PTR [rbp-28], edi
#         third: value.third + 3,
  mov eax, DWORD PTR [rbp-40]
  mov edi, eax
  add edi, 3
  mov DWORD PTR [rbp-24], edi
#         fourth: value.fourth + 4
  mov eax, DWORD PTR [rbp-36]
  mov edi, eax
  add edi, 4
  mov DWORD PTR [rbp-20], edi
#     return Quad {
#         first: value.first + 1,
#         second: value.second + 2,
#         third: value.third + 3,
#         fourth: value.fourth + 4
#     };
  sub rsp, 8
  mov QWORD PTR [rsp], 0
  mov eax, DWORD PTR [rbp-32]
  mov DWORD PTR [rsp], eax
  mov eax, DWORD PTR [rbp-32+4]
  mov DWORD PTR [rsp+4], eax
  mov rax, QWORD PTR [rsp]
  add rsp, 8
  sub rsp, 8
  mov QWORD PTR [rsp], 0
  mov eax, DWORD PTR [rbp-32+8]
  mov DWORD PTR [rsp], eax
  mov eax, DWORD PTR [rbp-32+8+4]
  mov DWORD PTR [rsp+4], eax
  mov rdx, QWORD PTR [rsp]
  add rsp, 8
  add rsp, 48
  pop rbp
  ret
